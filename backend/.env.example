# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of origins allowed to call this API.
# Add your Vercel frontend URL here.
ALLOWED_ORIGINS=https://funnynews.club,http://localhost:3000

# ── Firebase Admin SDK (server-side only) ─────────────────────────────────────
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=funnynews-8d9a4
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@funnynews-8d9a4.iam.gserviceaccount.com
# Paste the raw key — Railway escapes \n automatically
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── AI ────────────────────────────────────────────────────────────────────────
# Groq (primary LLM — free tier) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Google AI Studio (Gemini fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ── Optional scraper credentials ──────────────────────────────────────────────
# Reddit OAuth app (read-only) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── Cron schedule (default: every 2 hours) ────────────────────────────────────
# Standard cron syntax. Set to empty string to disable.
SCRAPE_CRON=0 */2 * * *
# Max stories per source per cron run
SCRAPE_MAX_PER_SOURCE=15
